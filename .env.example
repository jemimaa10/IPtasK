# Copy this file to .env and fill in your values.
PORT=3000

# Google Gemini API key (https://aistudio.google.com/apikey).
# Without it the app still works; AI split, AI proof hints and AI roast captions are disabled.
GEMINI_API_KEY=
# Optional. Comma-separated models, tried in order (fallbacks when one is busy or slow).
# GEMINI_MODEL=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite
