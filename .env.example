# Copy this file to .env and fill in your values.
PORT=3000

# Google Gemini API key (https://aistudio.google.com/apikey).
# Without it the app still works; AI split, AI proof hints and AI roast captions are disabled.
GEMINI_API_KEY=
# Optional. Comma-separated models, tried in order (fallbacks when one is busy or slow).
# GEMINI_MODEL=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite

# Set to "production" when deployed: session cookies become HTTPS-only.
# NODE_ENV=production
# Number of reverse proxies in front of the app (defaults to 1 in production).
# TRUST_PROXY=1

# Optional. "Continue with Google": create an OAuth client ID (Web application) in Google Cloud Console
# and add <your address>/api/auth/google/callback as an authorized redirect URI,
# e.g. http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public address of the app when deployed (used for the redirect URI).
# PUBLIC_URL=https://iptask.example.com
